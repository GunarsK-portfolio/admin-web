    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/vue-3": "^3.28.0",
    "@vicons/ionicons5": "^0.13.0",
    "axios": "^1.18.1",
    "naive-ui": "^2.44.1",
    "pinia": "^4.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "vue": "^3.5.40",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
